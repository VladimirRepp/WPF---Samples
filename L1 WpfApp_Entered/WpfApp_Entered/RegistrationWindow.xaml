<Window x:Class="WpfApp_Entered.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp_Entered"
        mc:Ignorable="d"
        Title="Регистрация" Height="600" Width="800">
   
    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   Text="Регистрация"
                   FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>
        
        <!-- Поле ввода имени -->
        <Grid Grid.Row="1"
              Margin="0 0 0 15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                        Text="Имя:"
                        FontSize="18"
                       VerticalAlignment="Stretch"/>

            <TextBox x:Name="NameTextBox"
                     Grid.Column="1"
                     Margin="2"
                     Height="25"
                     FontSize="16"/>

        </Grid>

        <!-- Поле ввода пароля -->
        <Grid Grid.Row="2"
          Margin="0 0 0 15">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                    Text="Пароль:"
                    FontSize="18"
                   VerticalAlignment="Stretch"/>

                <TextBox x:Name="PasswordTextBox"
                 Grid.Column="1"
                 Margin="2"
                 Height="25"
                 FontSize="16"/>

            </Grid>

        <!-- Поле выбора возраста -->
        <Grid Grid.Row="3"
              Margin="0 0 0 15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Возраст:"
                       FontSize="18"/>

            <StackPanel Grid.Column="1"
                        Orientation="Vertical">

                <RadioButton x:Name="ValueBefore16RadioButton"
                            Content="до 16" 
                             FontSize="16"
                             Margin="5"/>

                <RadioButton x:Name="Value16_22RadioButton"
                    Content="16-22" 
                     FontSize="16"
                     Margin="5"/>

                <RadioButton x:Name="ValueAfter22RadioButton"
                        Content="больше 22" 
                         FontSize="16"
                         Margin="5"/>

            </StackPanel>

        </Grid>

        <!-- Поле выбора пола -->
        <Grid Grid.Row="4"
                Margin="0 0 0 15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                Text="Пол:"
                FontSize="18"/>

            <StackPanel Grid.Column="1"
                 Orientation="Vertical">

                <RadioButton x:Name="MaleRadioButton"
                     Content="мужской" 
                      FontSize="16"
                      Margin="5"/>

                <RadioButton x:Name="FemaleRadioButton"
                     Content="женский" 
                      FontSize="16"
                      Margin="5"/>  

            </StackPanel>

        </Grid>

        <!-- Список городов -->
        <Grid Grid.Row="5" 
              Margin="0 0 0 15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                     Text="Город:"
                     FontSize="18"/>

            <ComboBox x:Name="CityComboBox"
                      Grid.Column="1"
                      Margin="5 "
                      FontSize="16"
                      SelectionChanged="CityComboBox_SelectionChanged">

                <ComboBoxItem Content="Красноярск"/>
                <ComboBoxItem Content="Новосибирск"/>
                <ComboBoxItem Content="Санкт-Петербург"/>
                <ComboBoxItem Content="Москва"/>

            </ComboBox>

        </Grid>
        
        <!-- Согласие -->
        <CheckBox Grid.Row="6"
                  x:Name="AgreementCheckBox"
                  Content="Я согласен с правилами (продать почку)"
                  FontSize="16"
                  Margin="0 5 0 15">
            
            <CheckBox.LayoutTransform>
                <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
            </CheckBox.LayoutTransform>
            
        </CheckBox>

        <!-- Информация о городе -->
        <TextBlock Grid.Row="7"
                   x:Name="CityInfoTextBlock"
                   Text=""
                   FontSize="14"
                   Foreground="Gray" 
                   HorizontalAlignment="Center"
                   Margin="0 0 0 15"/>
        
        <!-- Кнопка регистриации -->
        <Button Grid.Row="8"
                x:Name="RegisterButton"
                Height="45"
                Content="Зарегистрироваться"
                FontSize="20"
                FontWeight="Bold"
                Margin="5"
                Click="RegisterButton_Click"/>

        <!-- Перейти в окно Войти -->
        <Label Grid.Row="9"
               x:Name="EnterLabel"
               Content="Вход"
               FontSize="14"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               Margin="5"
               Foreground="Blue"
               MouseDoubleClick="EnterLabel_MouseDoubleClick"/>
 
    </Grid>
</Window>
