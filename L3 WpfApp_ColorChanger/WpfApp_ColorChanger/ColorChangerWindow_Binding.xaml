<Window x:Class="WpfApp_ColorChanger.ColorChangerWindow_Binding"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp_ColorChanger"
        mc:Ignorable="d"
        Title="ColorChangerWindow_Binding" Height="450" Width="800">
    
    <Grid Margin="30">
      
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
     
        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="Изменитель цвета" 
                   FontSize="28" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,30"/>
     
        <!-- Красный -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
          
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
           
            <TextBlock Grid.Column="0" 
                       Text="Красный:" 
                       FontSize="16"
                       VerticalAlignment="Center"/>
            
            <Slider x:Name="RedSlider" 
                    Grid.Column="1" 
                    Minimum="0" 
                    Maximum="255" 
                    Value="0" 
                    TickFrequency="1" 
                    IsSnapToTickEnabled="True" 
                    ValueChanged="ColorSlider_ValueChanged"/>
            
            <TextBlock Grid.Column="2" 
                       FontSize="16" 
                       HorizontalAlignment="Right" 
                       VerticalAlignment="Center" 
                       Text="{Binding ElementName=RedSlider, Path=Value, StringFormat={}{0:0}}" />
        </Grid>
       
        <!-- Зелёный -->
        <Grid Grid.Row="2" Margin="0,0,0,20">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" 
                       Text="Зелёный:" 
                       FontSize="16"
                       VerticalAlignment="Center"/>
            
            <Slider x:Name="GreenSlider" 
                    Grid.Column="1" 
                    Minimum="0" 
                    Maximum="255" 
                    Value="0" 
                    TickFrequency="1" 
                    IsSnapToTickEnabled="True" 
                    ValueChanged="ColorSlider_ValueChanged"/>
            
            <TextBlock Grid.Column="2" 
                       FontSize="16" 
                       HorizontalAlignment="Right" 
                       VerticalAlignment="Center" 
                       Text="{Binding ElementName=GreenSlider, Path=Value, StringFormat={}{0:0}}"/>
        </Grid>
       
        <!-- Синий -->
        <Grid Grid.Row="3" Margin="0,0,0,30">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>            
            </Grid.ColumnDefinitions>
           
            <TextBlock Grid.Column="0" 
                       Text="Синий:" 
                       FontSize="16" 
                       VerticalAlignment="Center"/>
            
            <Slider x:Name="BlueSlider" 
                    Grid.Column="1" 
                    Minimum="0" 
                    Maximum="255" 
                    Value="0" 
                    TickFrequency="1" 
                    IsSnapToTickEnabled="True" 
                    ValueChanged="ColorSlider_ValueChanged"/>
           
            <TextBlock Grid.Column="2" 
                       FontSize="16" 
                       HorizontalAlignment="Right" 
                       VerticalAlignment="Center" 
                       Text="{Binding ElementName=BlueSlider, Path=Value, StringFormat={}{0:0}}"/>
      
        </Grid>
       
        <!-- Предпросмотр -->
        <Border x:Name="ColorPreview"
                Grid.Row="4" 
                Width="220" 
                Height="180" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                BorderBrush="Black" 
                BorderThickness="2" 
                Background="Black"/>
        
        <!-- RGB -->
        <TextBlock Grid.Row="5" 
                   FontSize="18" 
                   HorizontalAlignment="Center" 
                   Margin="0,20,0,0"> 
            <!-- Run используется для возможности изменения цвета -->
            <Run Text="RGB: "/> 
            <Run Text="{Binding ElementName=RedSlider, Path=Value, StringFormat={}{0:0}}"/>
            <Run Text=", "/> 
            <Run Text="{Binding ElementName=GreenSlider, Path=Value, StringFormat={}{0:0}}"/> <Run Text=", "/> 
            <Run Text="{Binding ElementName=BlueSlider, Path=Value, StringFormat={}{0:0}}"/></TextBlock>

        <!-- Кнопка для перехода -->
        <Button Grid.Row="6" 
          Content="Перейти"
          FontSize="25"
          Margin="0,20,0,0"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Click="NavigateButton_Click"/>

    </Grid>
</Window>
