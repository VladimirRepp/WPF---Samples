<Window x:Class="WpfApp_ColorChanger.ColorChangerWindow_ValueChanged"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp_ColorChanger"
        mc:Ignorable="d"
        Title="ColorChangerWindow_ValueChanged" Height="450" Width="800">
    
    <Grid Margin="30">
       
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="Изменитель цвета" 
                   FontSize="28" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,30"/>
       
        <!-- Красный -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
           
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
           
            <TextBlock Grid.Column="0" 
                       Text="Красный:" 
                       FontSize="16" 
                       VerticalAlignment="Center"/>
            
            <Slider x:Name="RedSlider" 
                    Grid.Column="1" 
                    Minimum="0"
                    Maximum="255" 
                    Value="0" 
                    TickFrequency="1" 
                    IsSnapToTickEnabled="True" 
                    ValueChanged="ColorSlider_ValueChanged"/> <!-- Это событие используется у всех слайдеров -->
            
            <TextBlock x:Name="RedValueTextBlock" 
                       Grid.Column="2" 
                       Text="0" 
                       FontSize="16" 
                       HorizontalAlignment="Right" 
                       VerticalAlignment="Center"/>
        </Grid>
      
        <!-- Зелёный -->
        <Grid Grid.Row="2" Margin="0,0,0,20">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" 
                       Text="Зелёный:" 
                       FontSize="16" 
                       VerticalAlignment="Center"/>
            
            <Slider x:Name="GreenSlider" 
                    Grid.Column="1" 
                    Minimum="0" 
                    Maximum="255" 
                    Value="0"
                    TickFrequency="1" 
                    IsSnapToTickEnabled="True"
                    ValueChanged="ColorSlider_ValueChanged"/> <!-- Это событие используется у всех слайдеров -->
           
            <TextBlock x:Name="GreenValueTextBlock" 
                       Grid.Column="2" 
                       Text="0" 
                       FontSize="16" 
                       HorizontalAlignment="Right" 
                       VerticalAlignment="Center"/>
        
        </Grid>
     
        <!-- Синий -->
        <Grid Grid.Row="3" Margin="0,0,0,30">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" 
                       Text="Синий:" 
                       FontSize="16" 
                       VerticalAlignment="Center"/>
            
            <Slider x:Name="BlueSlider" 
                    Grid.Column="1" 
                    Minimum="0" 
                    Maximum="255" 
                    Value="0" 
                    TickFrequency="1" 
                    IsSnapToTickEnabled="True" 
                    ValueChanged="ColorSlider_ValueChanged"/> <!-- Это событие используется у всех слайдеров -->
           
            <TextBlock x:Name="BlueValueTextBlock" 
                       Grid.Column="2" 
                       Text="0" 
                       FontSize="16" 
                       HorizontalAlignment="Right" 
                       VerticalAlignment="Center"/>
       
        </Grid>
        
        <!-- Область цвета -->
        <Border x:Name="ColorPreview" 
                Grid.Row="4" 
                Width="220" 
                Height="180" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                BorderBrush="Black" 
                BorderThickness="2" 
                Background="Black"/>
        
        <!-- RGB -->
        <TextBlock x:Name="RgbTextBlock" 
                   Grid.Row="5" 
                   Text="RGB: 0, 0, 0" 
                   FontSize="18" 
                   HorizontalAlignment="Center" 
                   Margin="0,20,0,0"/>

        <!-- Кнопка для перехода -->
        <Button Grid.Row="6" 
                Content="Перейти"
                FontSize="25"
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="NavigateButton_Click"/>
    
    </Grid>
    
</Window>
